---
import { Image } from 'astro:assets';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import ChamadaContato from '../components/ChamadaContato.astro';
import Galeria from '../components/Galeria.astro';
import Icone from '../components/Icone.astro';
import LinhaDoTempo from '../components/LinhaDoTempo.astro';
import Pendente from '../components/Pendente.astro';
import Polaroid from '../components/Polaroid.astro';
import TituloSecao from '../components/TituloSecao.astro';
import Base from '../layouts/Base.astro';
import type { ItemTempo } from '../components/LinhaDoTempo.astro';
import { obterCuriosidades, obterEquipe, obterIntegrantes, obterMarcos, obterShows } from '../lib/conteudo';
import { dataLonga, listaNatural } from '../lib/datas';
import { imagem, imagemObrigatoria } from '../lib/imagens';
import { musicGroup } from '../lib/seo';
import { site } from '../lib/site';
import { url, urlAbsoluta } from '../lib/url';

const integrantes = await obterIntegrantes();
const marcos = await obterMarcos();
const { realizados } = await obterShows();

/* Linha do tempo: marcos + shows já realizados, em ordem de data. Show na
   mesma data de um marco (ex.: a estreia) não aparece duas vezes. */
const datasDeMarcos = new Set(marcos.ventocais.map((m) => m.data.data));
const paraItem = (m: (typeof marcos.ventocais)[number]): ItemTempo => ({
  id: m.id,
  ordem: m.data.data ?? '',
  quando: m.data.data ? dataLonga(m.data.data) : (m.data.dataTexto ?? ''),
  titulo: m.data.titulo,
  texto: m.data.texto,
  pendente: m.data.pendente,
  rascunho: m.data.rascunho,
});
const tempoOrigami = marcos.origami.map(paraItem);
const tempoVentocais = [
  ...marcos.ventocais.map(paraItem),
  ...realizados
    .filter((s) => s.data.data && !datasDeMarcos.has(s.data.data))
    .map((s) => ({
      id: `show-${s.id}`,
      ordem: s.data.data!,
      quando: dataLonga(s.data.data!),
      titulo: s.data.evento,
      texto: [s.data.local.nome, s.data.local.cidade].filter(Boolean).join(' · ') +
        (s.data.lineup.length ? `, com ${listaNatural(s.data.lineup)}` : ''),
      show: true,
      link: url(`/agenda/#show-${s.id}`),
    })),
].sort((a, b) => a.ordem.localeCompare(b.ordem));
const curiosidades = await obterCuriosidades();
const equipe = await obterEquipe();

const fotoCapa = imagemObrigatoria('fotos/praia-caminhada.jpg');
const giros = [-3, 2.5, -1.5, 3, -2.5];
const papeis = ['', 'papel--ceu', 'papel--perola', 'papel--terracota'];

const foto = (caminho: string, alt: string, credito?: string) => ({
  src: imagemObrigatoria(caminho),
  alt,
  legenda: credito ? `${alt} · Foto: ${credito}` : alt,
});
const fotos = [
  foto('fotos/ensaio-campo/02.jpg', 'Três integrantes contra o céu azul'),
  foto('fotos/ensaio-praia/05.jpg', 'A banda à sombra de um guarda-sol, na praia', 'Lia Teles'),
  foto('fotos/ensaio-campo/05.jpg', 'Três integrantes contra o sol'),
  foto('fotos/shows/2024-01-12-estreia/03.jpg', 'O palco do Che Music Bar no show de estreia', 'Luca Skate'),
  foto('fotos/ensaio-praia/03.jpg', 'Retrato na praia', 'Lia Teles'),
  foto('fotos/ensaio-campo/04.jpg', 'Três integrantes vistos de baixo, com o céu ao fundo'),
  foto('fotos/shows/caju-summer-vibes/05.jpg', 'Guitarra no Taberna Rock Bar, em preto e branco', 'Lia Teles'),
  foto('fotos/ensaio-campo/01.jpg', 'A banda no alto de uma duna verde'),
  foto('fotos/ensaio-praia/02.jpg', 'Os integrantes caminhando na areia', 'Lia Teles'),
  foto('fotos/shows/2026-08-08-pareia/06.jpg', 'Show no Onça'),
  foto('fotos/ensaio-campo/06.jpg', 'Três integrantes na luz dourada do fim de tarde'),
  foto('fotos/ensaio-praia/04.jpg', 'Integrante de camisa florida na praia', 'Lia Teles'),
  foto('fotos/ensaio-campo/03.jpg', 'Três integrantes olhando para a câmera, de baixo para cima'),
  foto('fotos/ensaio-praia/01.jpg', 'A banda caminhando ao longe, à beira-mar', 'Lia Teles'),
];

const jsonLd = musicGroup(
  urlAbsoluta('/', Astro.site),
  urlAbsoluta('/og/og-padrao.jpg', Astro.site),
  integrantes,
);
---

<Base
  titulo="Sobre"
  descricao={`Conheça ${site.nome}: bio, formação, trajetória, influências e curiosidades da banda autoral de ${site.cidade} (${site.uf}).`}
  imagem={fotoCapa}
  jsonLd={jsonLd}
>
  <CabecalhoPagina
    num="02"
    rotulo="Sobre"
    titulo="Um cais <em>inventado</em>"
    anotacao="(e uma banda inteira morando nele)"
    intro={site.slogan}
  >
    <figure class="sobre-capa fita" style="--fita-rot: 4deg">
      <Image
        src={fotoCapa}
        alt="Os integrantes caminhando lado a lado na praia"
        widths={[480, 720, 1000]}
        sizes="(max-width: 900px) 90vw, 460px"
        loading="eager"
      />
    </figure>
  </CabecalhoPagina>

  <section class="secao secao--colada">
    <div class="container sobre-bio">
      <div class="prosa texto-grande" data-revelar>
        {site.bioLonga.map((p) => <p>{p}</p>)}
      </div>
      <aside class="sobre-nome papel rasgado" data-revelar style="--atraso: .15s">
        <p class="anotacao sobre-nome__titulo">de onde vem o nome?</p>
        <p>{site.origemDoNome}</p>
      </aside>
    </div>
  </section>

  <section class="secao" id="formacao">
    <div class="container">
      <TituloSecao num="02.1" rotulo="Formação" titulo="Quem <em>toca</em>" anotacao="passa o mouse nas polaroids" />
      <Pendente texto={site.formacaoPendente} />
      <div class="formacao">
        {
          integrantes.map((m, i) => (
            <Polaroid
              foto={imagem(m.data.foto)}
              alt={`Foto de ${m.data.nome}`}
              nome={m.data.nome}
              detalhe={m.data.funcao}
              giro={giros[i % giros.length]}
              link={m.data.instagram}
              pendente={m.data.pendente}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="secao secao--escura" id="trajetoria">
    <div class="container container--estreito">
      <TituloSecao num="02.2" rotulo="Trajetória" titulo="Do Origami Aquém <em>à primeira turnê</em>" />
      <LinhaDoTempo origami={tempoOrigami} ventocais={tempoVentocais} />
    </div>
  </section>

  <section class="secao" id="influencias">
    <div class="container">
      <TituloSecao num="02.3" rotulo="Influências" titulo="Na <em>vitrola</em> da banda" />
      <div class="influencias">
        {
          site.influencias.map((g, i) => (
            <div class="influencias__grupo" data-revelar style={`--atraso: ${i * 0.08}s`}>
              <h3 class="rotulo">{g.grupo}</h3>
              <ul class="lista-chips">
                {g.nomes.map((n) => (
                  <li class="chip">{n}</li>
                ))}
              </ul>
              {g.nota && <p class="influencias__nota">{g.nota}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="secao secao--colada" id="curiosidades">
    <div class="container">
      <TituloSecao num="02.4" rotulo="Curiosidades" titulo="Histórias <em>de bastidor</em>" />
      <ul role="list" class="curiosidades">
        {
          curiosidades.map((c, i) => (
            <li
              class:list={['curiosidade', 'papel', papeis[i % papeis.length]]}
              data-revelar
              style={`--atraso: ${(i % 3) * 0.08}s; --giro: ${((i * 37) % 5) - 2}deg`}
            >
              <p class="curiosidade__tag">{c.data.tag}</p>
              <h3 class="curiosidade__titulo">{c.data.titulo}</h3>
              <p>{c.data.texto}</p>
              <Pendente texto={c.data.pendente} rascunho={c.data.rascunho} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    equipe.length > 0 && (
      <section class="secao secao--escura" id="equipe">
        <div class="container">
          <TituloSecao num="02.5" rotulo="Equipe e parceiros" titulo="Quem faz <em>junto</em>" />
          <ul role="list" class="equipe">
            {equipe.map((p, i) => {
              const foto = imagem(p.data.foto);
              const iniciais = p.data.nome
                .split(' ')
                .filter((n) => n.length > 2)
                .map((n) => n[0])
                .slice(0, 2)
                .join('');
              return (
                <li
                  class:list={['equipe__item', { 'equipe__item--destaque': p.data.destaque }]}
                  data-revelar
                  style={`--atraso: ${i * 0.08}s`}
                >
                  {p.data.destaque && (
                    <div class="equipe__foto fita">
                      {foto ? (
                        <Image
                          src={foto}
                          alt={`Foto de ${p.data.nome}`}
                          widths={[280, 420, 600]}
                          sizes="(max-width: 700px) 70vw, 280px"
                        />
                      ) : (
                        <span class="equipe__foto-vazia papel" aria-hidden="true">
                          <span class="equipe__iniciais">{iniciais}</span>
                          <span class="anotacao">foto em breve</span>
                        </span>
                      )}
                    </div>
                  )}
                  <div class="equipe__texto">
                    <h3 class="equipe__nome">{p.data.nome}</h3>
                    <p class="equipe__papel">{p.data.papel}</p>
                    {p.data.detalhes && <p class="equipe__detalhes">{p.data.detalhes}</p>}
                    {p.data.link && (
                      <a class="link-icone" href={p.data.link} target="_blank" rel="noopener">
                        <Icone nome="instagram" tamanho={18} /> Instagram
                      </a>
                    )}
                    <Pendente texto={p.data.pendente} rascunho={p.data.rascunho} />
                  </div>
                </li>
              );
            })}
          </ul>
          <p class="equipe__selo">
            Distribuição: {site.distribuidora} · Associação de direitos: {site.associacao}
          </p>
        </div>
      </section>
    )
  }

  <section class="secao" id="fotos">
    <div class="container">
      <TituloSecao num="02.6" rotulo="Fotos" titulo="Campo, praia <em>e palco</em>" anotacao="clica pra ampliar" />
      <Pendente texto={site.creditos.pendente} />
      <Galeria fotos={fotos} grupo="sobre" />
      {site.creditos.fotos && <p class="sobre-credito">Fotos: {site.creditos.fotos}</p>}
    </div>
  </section>

  <ChamadaContato />
</Base>

<style>
  .sobre-capa {
    justify-self: center;
    width: min(100%, 460px);
    margin: 0;
    padding: 10px 10px 46px;
    rotate: 3deg;
    background: #efe8d8;
    box-shadow: 0 40px 60px -30px rgb(0 0 0 / 0.8);
    animation: cp-foto 1.2s var(--ease-out) 0.25s both;
  }

  .sobre-capa :global(img) {
    width: 100%;
  }

  @keyframes cp-foto {
    from {
      opacity: 0;
      rotate: 12deg;
      translate: 0 40px;
    }
  }

  .sobre-bio {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }

  @media (min-width: 960px) {
    .sobre-bio {
      grid-template-columns: 1.4fr 0.8fr;
    }

    .sobre-nome {
      position: sticky;
      top: calc(var(--altura-topo) + 32px);
    }
  }

  .sobre-nome {
    padding: 40px 32px;
    rotate: 1.5deg;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .sobre-nome__titulo {
    margin-bottom: 12px;
    color: #7a3416;
    font-size: 2rem;
  }

  .formacao {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: clamp(20px, 3vw, 40px);
    margin-top: 16px;
  }

  .influencias {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 40px 56px;
  }

  .influencias__grupo {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .influencias__nota {
    color: var(--perola-3);
    font-size: 0.88rem;
  }

  .curiosidades {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 24px;
  }

  .curiosidade {
    padding: 30px 28px;
    border-radius: 4px;
    rotate: var(--giro);
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.7);
    transition: rotate 0.5s var(--ease-elastico);
  }

  .curiosidade:hover {
    rotate: 0deg;
  }

  .curiosidade__tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .curiosidade__titulo {
    margin: 8px 0 12px;
    font-family: var(--fonte-mao);
    font-size: 2.1rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
  }

  .equipe {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }

  .equipe__item {
    padding: 28px;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
  }

  /* Cartão de destaque (o produtor): foto em moldura + texto maior. */
  .equipe__item--destaque {
    grid-column: 1 / -1;
    display: grid;
    gap: 28px 44px;
    align-items: center;
    padding: clamp(28px, 4vw, 44px);
    background: rgb(236 230 216 / 0.03);
  }

  @media (min-width: 760px) {
    .equipe__item--destaque {
      grid-template-columns: 260px 1fr;
    }
  }

  .equipe__foto {
    width: min(100%, 260px);
    margin: 8px auto 0;
    padding: 10px 10px 38px;
    rotate: -2.5deg;
    background: #efe8d8;
    box-shadow: 0 30px 50px -24px rgb(0 0 0 / 0.8);
  }

  .equipe__foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .equipe__foto-vazia {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    aspect-ratio: 4 / 5;
  }

  .equipe__iniciais {
    font-family: var(--fonte-display);
    font-size: 4rem;
    font-style: italic;
    line-height: 1;
  }

  .equipe__foto-vazia .anotacao {
    color: #7a3416;
  }

  .equipe__texto {
    display: grid;
    gap: 6px;
    justify-items: start;
  }

  .equipe__nome {
    font-size: 1.55rem;
  }

  .equipe__item--destaque .equipe__nome {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .equipe__item--destaque .equipe__detalhes {
    max-width: 52ch;
    font-size: 1.05rem;
  }

  .equipe__papel {
    margin-top: 6px;
    color: var(--kraft);
    font-weight: 600;
  }

  .equipe__detalhes {
    margin-top: 10px;
    color: var(--perola-2);
    font-size: 0.95rem;
  }

  .equipe__selo {
    margin-top: 32px;
    color: var(--perola-3);
    font-size: 0.9rem;
  }
</style>
