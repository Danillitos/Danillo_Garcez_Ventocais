---
/**
 * Polaroid (as fotos já vêm com a moldura escura) com legenda à mão.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Pendente from './Pendente.astro';

interface Props {
  foto?: ImageMetadata;
  alt: string;
  nome?: string;
  detalhe?: string;
  giro?: number;
  link?: string;
  pendente?: string;
  tamanhos?: string;
}

const {
  foto,
  alt,
  nome,
  detalhe,
  giro = -2,
  link,
  pendente,
  tamanhos = '(max-width: 640px) 60vw, 260px',
} = Astro.props;
const Tag = link ? 'a' : 'div';
---

<div class="polaroid" style={`--giro: ${giro}deg`} data-revelar>
  <Tag class="polaroid__moldura" href={link} target={link ? '_blank' : undefined} rel={link ? 'noopener' : undefined}>
    {
      foto ? (
        <Image src={foto} alt={alt} widths={[280, 420, 600]} sizes={tamanhos} />
      ) : (
        <span class="polaroid__vazia" role="img" aria-label={alt} />
      )
    }
    {
      (nome || detalhe) && (
        <span class="polaroid__legenda">
          {nome && <span class="polaroid__nome">{nome}</span>}
          {detalhe && <span class="polaroid__detalhe">{detalhe}</span>}
        </span>
      )
    }
  </Tag>
  <Pendente texto={pendente} />
</div>

<style>
  .polaroid {
    display: grid;
    justify-items: center;
  }

  .polaroid__moldura {
    position: relative;
    display: block;
    width: 100%;
    rotate: var(--giro);
    filter: drop-shadow(0 18px 22px rgb(0 0 0 / 0.5));
    transition:
      rotate 0.55s var(--ease-elastico),
      transform 0.55s var(--ease-elastico);
  }

  .polaroid__moldura:hover,
  .polaroid__moldura:focus-visible {
    rotate: 0deg;
    transform: translateY(-8px) scale(1.04);
  }

  .polaroid__moldura :global(img) {
    width: 100%;
  }

  .polaroid__vazia {
    display: block;
    aspect-ratio: 8 / 9;
    background: #17100f;
  }

  /* A legenda fica na faixa escura de baixo da moldura (os 21% finais da foto). */
  .polaroid__legenda {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 0;
    height: 21%;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
  }

  .polaroid__nome {
    color: #f4efe6;
    font-family: var(--fonte-mao);
    font-size: clamp(1.3rem, 2.1vw, 1.7rem);
    font-weight: 600;
    line-height: 1;
  }

  .polaroid__detalhe {
    color: var(--kraft-claro);
    font-family: var(--fonte-mao);
    font-size: clamp(0.92rem, 1.35vw, 1.1rem);
    line-height: 1.05;
  }
</style>
