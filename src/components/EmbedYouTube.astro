---
/**
 * Vídeo do YouTube que só carrega o player no clique. Sem ID, mostra a
 * capa com o aviso "em breve".
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icone from './Icone.astro';

interface Props {
  id?: string;
  titulo: string;
  capa?: ImageMetadata;
}

const { id, titulo, capa } = Astro.props;
const src = id ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1` : undefined;
const miniatura = id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : undefined;
---

<div class="video" data-embed-alvo>
  {
    src ? (
      <button class="video__fachada" type="button" data-embed={src} data-embed-titulo={titulo}>
        {capa ? (
          <Image src={capa} alt="" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 900px" />
        ) : (
          <img src={miniatura} alt="" loading="lazy" />
        )}
        <span class="video__play">
          <Icone nome="play" tamanho={30} />
        </span>
        <span class="sr-only">Assistir “{titulo}”</span>
      </button>
    ) : (
      <div class="video__fachada video__fachada--breve">
        {capa && <Image src={capa} alt="" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 900px" />}
        <span class="video__breve anotacao">vídeo em breve por aqui</span>
      </div>
    )
  }
</div>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--raio);
    background: var(--ink-800);
    box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.8);
  }

  .video__fachada {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .video__fachada :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s var(--ease-out),
      filter 0.4s;
  }

  .video__fachada::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgb(7 11 20 / 0.65));
  }

  button.video__fachada:hover :global(img) {
    transform: scale(1.04);
  }

  .video__play {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--perola);
    color: var(--ink-900);
    transition: transform 0.45s var(--ease-elastico);
  }

  .video__play :global(svg) {
    translate: 3px 0;
  }

  button.video__fachada:hover .video__play {
    transform: scale(1.1);
  }

  .video__fachada--breve :global(img) {
    filter: saturate(0.7) brightness(0.65);
  }

  .video__breve {
    position: relative;
    z-index: 1;
    padding: 8px 18px;
    rotate: -3deg;
    background: var(--kraft);
    color: var(--kraft-texto);
    font-size: clamp(1.4rem, 3vw, 2rem);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
  }

  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
