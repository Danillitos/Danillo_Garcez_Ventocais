---
/**
 * Contagem regressiva para o próximo show (atualizada por scripts/agenda.ts).
 */
import type { Show } from '../lib/conteudo';
import { descricaoLocal } from '../lib/agenda';
import { dataLonga, diaDaSemana, inicioISO } from '../lib/datas';
import { url } from '../lib/url';

interface Props {
  show: Show;
}

const { show } = Astro.props;
const s = show.data;
const alvo = s.data ? inicioISO(s.data, s.hora ?? '20:00') : undefined;
---

{
  alvo && s.data && (
    <a
      class="contagem papel rasgado"
      href={url(`/agenda/#show-${show.id}`)}
      data-contagem={alvo}
      data-contagem-com-hora={s.hora ? 'sim' : 'nao'}
      data-revelar
    >
      <span class="contagem__titulo anotacao">próximo show em...</span>
      <span class="contagem__numeros" role="timer" aria-live="off">
        <span>
          <b data-c="dias">--</b>
          <small>dias</small>
        </span>
        <span data-c-hora>
          <b data-c="horas">--</b>
          <small>horas</small>
        </span>
        <span data-c-hora>
          <b data-c="min">--</b>
          <small>min</small>
        </span>
        <span data-c-hora>
          <b data-c="seg">--</b>
          <small>seg</small>
        </span>
      </span>
      <span class="contagem__show">
        <strong>{s.evento}</strong>
        <span>
          {diaDaSemana(s.data)}, {dataLonga(s.data)} · {descricaoLocal(s)}
        </span>
      </span>
    </a>
  )
}

<style>
  .contagem {
    --papel-cor: var(--kraft);
    display: grid;
    gap: 14px;
    padding: 36px clamp(22px, 4vw, 40px) 34px;
    rotate: -1.2deg;
    transition: rotate 0.5s var(--ease-elastico);
  }

  .contagem:hover {
    rotate: 0deg;
  }

  .contagem__titulo {
    color: #7a3416;
    font-size: 1.7rem;
  }

  .contagem__numeros {
    display: flex;
    flex-wrap: wrap;
    gap: 10px clamp(14px, 3vw, 28px);
  }

  .contagem__numeros > span {
    display: grid;
    justify-items: start;
  }

  .contagem__numeros b {
    font-family: var(--fonte-display);
    font-size: clamp(2.8rem, 6vw, 4.4rem);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .contagem__numeros small {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contagem__show {
    display: grid;
    gap: 2px;
    padding-top: 14px;
    border-top: 1px dashed rgb(43 32 21 / 0.35);
  }

  .contagem__show strong {
    font-family: var(--fonte-display);
    font-size: 1.35rem;
    font-weight: 500;
  }
</style>
