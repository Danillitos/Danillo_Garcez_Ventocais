---
/**
 * Galeria em colunas (masonry). Cada foto abre no visualizador.
 */
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';

interface Foto {
  src: ImageMetadata;
  alt: string;
  legenda?: string;
}

interface Props {
  fotos: Foto[];
  grupo?: string;
}

const { fotos, grupo = 'galeria' } = Astro.props;
const grandes = await Promise.all(fotos.map((f) => getImage({ src: f.src, width: 1800, format: 'webp' })));
---

<ul class="galeria" role="list">
  {
    fotos.map((f, i) => (
      <li data-revelar style={`--atraso: ${(i % 3) * 0.08}s`}>
        <button
          class="galeria__item"
          type="button"
          data-lightbox={grupo}
          data-src={grandes[i]?.src}
          data-legenda={f.legenda ?? f.alt}
          data-alt={f.alt}
          aria-label={`Ampliar foto: ${f.alt}`}
        >
          <Image src={f.src} alt={f.alt} widths={[400, 640, 900]} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 400px" />
        </button>
      </li>
    ))
  }
</ul>

<style>
  .galeria {
    columns: 3 260px;
    column-gap: 14px;
  }

  .galeria li {
    break-inside: avoid;
    margin-bottom: 14px;
  }

  .galeria__item {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 6px;
    cursor: zoom-in;
  }

  .galeria__item :global(img) {
    width: 100%;
    transition:
      transform 0.9s var(--ease-out),
      filter 0.4s;
  }

  .galeria__item:hover :global(img) {
    transform: scale(1.05);
    filter: saturate(1.15);
  }
</style>
