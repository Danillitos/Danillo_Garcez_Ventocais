---
/**
 * Trajetória: Origami Aquém → Ventocais. Mistura os marcos (data/marcos.json)
 * com os shows já realizados (data/shows.json). A linha vai se preenchendo
 * conforme a pessoa rola a página (scripts/linha-do-tempo.ts).
 */
import Icone from './Icone.astro';
import Pendente from './Pendente.astro';

export interface ItemTempo {
  id: string;
  /** Chave de ordenação (AAAA-MM-DD). */
  ordem?: string;
  quando: string;
  titulo: string;
  texto?: string;
  pendente?: string;
  rascunho?: boolean;
  /** Shows aparecem mais discretos, com link para a Agenda. */
  show?: boolean;
  link?: string;
}

interface Props {
  origami: ItemTempo[];
  ventocais: ItemTempo[];
}

const { origami, ventocais } = Astro.props;
const eras = [
  { titulo: 'Antes: <em>Origami Aquém</em>', itens: origami, classe: 'era--origami' },
  { titulo: 'Danillo Garcez <em>&amp;</em> Ventocais', itens: ventocais, classe: 'era--ventocais' },
].filter((e) => e.itens.length > 0);
---

<div class="tempo" data-linha-tempo>
  <div class="tempo__trilho" aria-hidden="true">
    <span class="tempo__progresso"></span>
  </div>
  {
    eras.map((era) => (
      <section class:list={['era', era.classe]}>
        <h3 class="era__titulo" set:html={era.titulo} />
        <ol role="list" class="era__lista">
          {era.itens.map((m) => (
            <li class:list={['marco', { 'marco--show': m.show }]} data-revelar>
              <p class="marco__data">{m.quando}</p>
              <h4 class="marco__titulo">
                {m.show && (
                  <span class="marco__tag">
                    <Icone nome="ingresso" tamanho={14} /> show
                  </span>
                )}
                {m.link ? <a href={m.link}>{m.titulo}</a> : m.titulo}
              </h4>
              {m.texto && <p class="marco__texto">{m.texto}</p>}
              <Pendente texto={m.pendente} rascunho={m.rascunho} />
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .tempo {
    position: relative;
    padding-left: 44px;
  }

  .tempo__trilho {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 11px;
    width: 2px;
    background: var(--linha);
  }

  .tempo__progresso {
    display: block;
    width: 100%;
    height: calc(var(--progresso, 0) * 100%);
    background: linear-gradient(var(--kraft), var(--acento));
    box-shadow: 0 0 12px var(--acento);
  }

  .era + .era {
    margin-top: 56px;
  }

  .era__titulo {
    margin-bottom: 24px;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
  }

  .era__titulo :global(em) {
    color: var(--kraft);
  }

  .era__lista {
    display: grid;
    gap: 36px;
  }

  .marco {
    position: relative;
  }

  .marco::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: -39px;
    width: 12px;
    height: 12px;
    border: 2px solid var(--kraft);
    border-radius: 50%;
    background: var(--ink-900);
    transition:
      background-color 0.4s,
      box-shadow 0.4s;
  }

  .marco:global(.visivel)::before {
    background: var(--kraft);
    box-shadow: 0 0 0 6px rgb(201 166 121 / 0.15);
  }

  .era--origami .marco::before {
    border-color: var(--perola-3);
  }

  .era--origami .marco:global(.visivel)::before {
    background: var(--perola-3);
    box-shadow: none;
  }

  /* Shows: ponto menor e azul, título menor. */
  .marco--show::before {
    top: 0.65em;
    left: -37px;
    width: 8px;
    height: 8px;
    border-color: var(--acento);
  }

  .marco--show:global(.visivel)::before {
    background: var(--acento);
    box-shadow: none;
  }

  .marco__data {
    color: var(--kraft);
    font-family: var(--fonte-mao);
    font-size: 1.45rem;
    line-height: 1;
  }

  .marco--show .marco__data {
    color: var(--perola-3);
    font-size: 1.25rem;
  }

  .era--origami .marco__data {
    color: var(--perola-3);
  }

  .marco__titulo {
    margin-top: 6px;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 420;
  }

  .marco--show .marco__titulo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
  }

  .marco__titulo a:hover {
    color: var(--acento);
  }

  .marco__tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border: 1px solid var(--linha-forte);
    border-radius: 999px;
    color: var(--acento);
    font-family: var(--fonte-texto);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .marco__texto {
    max-width: 52ch;
    margin-top: 6px;
    color: var(--perola-2);
  }

  .marco--show .marco__texto {
    font-size: 0.95rem;
  }

  @media (min-width: 900px) {
    .marco {
      display: grid;
      grid-template-columns: 200px 1fr;
      column-gap: 32px;
    }

    .marco__data {
      grid-row: span 3;
      padding-top: 0.2em;
    }

    .marco > :global(.pendente) {
      grid-column: 2;
    }
  }
</style>
